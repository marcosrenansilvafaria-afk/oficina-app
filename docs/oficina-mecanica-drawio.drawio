        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml C1_Oficina_Context\n!ROUNDED_STYLE=1\n!NEW_C4_STYLE=1\n!theme C4_united from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml\nLAYOUT_LEFT_RIGHT()\n\ntitle C1 - Contexto do Sistema Oficina (MVP)\n\nPerson(cliente, \&quot;Cliente\&quot;, \&quot;Solicita servicos e aprova orcamento\&quot;)\nPerson(atendente, \&quot;Atendente\&quot;, \&quot;Cria e gerencia ordem de servico\&quot;)\nPerson(mecanico, \&quot;Mecanico\&quot;, \&quot;Executa servicos da ordem\&quot;)\n\nSystem(sistema, \&quot;Sistema Oficina (Backend API)\&quot;, \&quot;Gerencia OS, clientes, veiculos, pecas e servicos\&quot;)\nSystem_Ext(secretEnv, \&quot;Ambiente (.env)\&quot;, \&quot;JWT_SECRET para assinatura dos tokens\&quot;)\n\nSystem_Ext(notificacao, \&quot;Servico de Notificacao\&quot;, \&quot;Integracao futura para envio de mensagens\&quot;)\nSystem_Ext(pagamento, \&quot;Gateway de Pagamento\&quot;, \&quot;Integracao futura para pagamentos\&quot;)\n\nRel(cliente, sistema, \&quot;Consulta status e aprova orcamento\&quot;, \&quot;HTTP/REST (JWT quando protegido)\&quot;)\nRel(atendente, sistema, \&quot;Cria e gerencia OS\&quot;, \&quot;HTTP/REST + Login JWT\&quot;)\nRel(mecanico, sistema, \&quot;Atualiza execucao\&quot;, \&quot;HTTP/REST + Login JWT\&quot;)\nRel(sistema, secretEnv, \&quot;Le JWT_SECRET\&quot;, \&quot;dotenv\&quot;)\n\nRel(sistema, notificacao, \&quot;Envia notificacoes\&quot;, \&quot;Async (futuro)\&quot;)\nRel(sistema, pagamento, \&quot;Processa pagamentos\&quot;, \&quot;HTTP (futuro)\&quot;)\n\nSHOW_LEGEND()\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="bwQrumHiELmRNkQxHxm8-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="701" width="1148" x="3439" y="105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml C2_Oficina_Container\n\n!ROUNDED_STYLE=1\n!NEW_C4_STYLE=1\n!theme C4_united from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml\nLAYOUT_LEFT_RIGHT()\n\ntitle C2 - Containers do Sistema Oficina (MVP)\n\nPerson(cliente, \&quot;Cliente\&quot;)\nPerson(atendente, \&quot;Atendente\&quot;)\nPerson(mecanico, \&quot;Mecanico\&quot;)\n\nSystem_Boundary(s1, \&quot;Sistema Oficina\&quot;) {\n  Container(api, \&quot;API Backend\&quot;, \&quot;NestJS (Node.js)\&quot;, \&quot;Exposicao REST, validacoes e orquestracao dos casos de uso\&quot;)\n  Container(repoMemory, \&quot;Repositorio In-Memory\&quot;, \&quot;In-memory\&quot;, \&quot;Persistencia temporaria para MVP e fase inicial de testes\&quot;)\n}\n\nContainerDb_Ext(dbFuturo, \&quot;Banco de Dados\&quot;, \&quot;PostgreSQL/NoSQL (planejado)\&quot;, \&quot;Substituira os repositorios in-memory apos a fase de testes\&quot;)\nSystem_Ext(secretEnv, \&quot;Ambiente (.env)\&quot;, \&quot;JWT_SECRET para assinatura/validacao JWT\&quot;)\nSystem_Ext(notificacao, \&quot;Servico de Notificacao\&quot;, \&quot;Integracao futura\&quot;)\nSystem_Ext(pagamento, \&quot;Gateway de Pagamento\&quot;, \&quot;Integracao futura\&quot;)\n\nRel(cliente, api, \&quot;Consulta status e aprova orcamento\&quot;, \&quot;HTTP/REST\&quot;)\nRel(atendente, api, \&quot;Login e operacao autenticada\&quot;, \&quot;HTTP/REST + JWT\&quot;)\nRel(mecanico, api, \&quot;Login e operacao autenticada\&quot;, \&quot;HTTP/REST + JWT\&quot;)\n\nRel(api, repoMemory, \&quot;Le e escreve dados\&quot;, \&quot;Repository pattern\&quot;)\nRel(api, secretEnv, \&quot;Le JWT_SECRET\&quot;, \&quot;dotenv\&quot;)\nRel(api, dbFuturo, \&quot;Migracao planejada apos fase de testes\&quot;, \&quot;JDBC/ORM (futuro)\&quot;)\nRel(api, notificacao, \&quot;Envia notificacoes\&quot;, \&quot;Async (futuro)\&quot;)\nRel(api, pagamento, \&quot;Processa pagamentos\&quot;, \&quot;HTTP (futuro)\&quot;)\n\nSHOW_LEGEND()\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="bwQrumHiELmRNkQxHxm8-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;labelBackgroundColor=light-dark(#FFFFFF,#000000);" vertex="1">
            <mxGeometry height="1024" width="1032" x="4865" y="105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml C3_Oficina_Component\n!ROUNDED_STYLE=1\n!NEW_C4_STYLE=1\n!theme C4_united from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml\nLAYOUT_LEFT_RIGHT()\n\ntitle C3 - Componentes da API Backend Oficina (MVP)\n\nPerson(cliente, \&quot;Cliente\&quot;)\nPerson(atendente, \&quot;Atendente\&quot;)\nPerson(mecanico, \&quot;Mecanico\&quot;)\n\nSystem_Ext(notificacao, \&quot;Servico de Notificacao\&quot;, \&quot;Integracao futura\&quot;)\nSystem_Ext(pagamento, \&quot;Gateway de Pagamento\&quot;, \&quot;Integracao futura\&quot;)\n\nContainer_Boundary(api, \&quot;API Backend (NestJS)\&quot;) {\n  Component(httpControllers, \&quot;HTTP Controllers\&quot;, \&quot;NestJS Controllers\&quot;, \&quot;Endpoints REST para OS, cliente, veiculo, servico e peca\&quot;)\n  Component(authController, \&quot;AuthController\&quot;, \&quot;NestJS Controller\&quot;, \&quot;Endpoint de login JWT\&quot;)\n  Component(authService, \&quot;AuthService\&quot;, \&quot;Application Service\&quot;, \&quot;Valida credenciais mock e emite access token\&quot;)\n  Component(jwtStrategy, \&quot;JwtStrategy\&quot;, \&quot;Passport JWT\&quot;, \&quot;Valida assinatura e expiracao do token\&quot;)\n  Component(jwtGuard, \&quot;JwtAuthGuard\&quot;, \&quot;Nest Guard\&quot;, \&quot;Exige Authorization Bearer\&quot;)\n  Component(rolesGuard, \&quot;RolesGuard\&quot;, \&quot;Nest Guard\&quot;, \&quot;Valida permissoes por perfil\&quot;)\n  Component(useCases, \&quot;Application Use Cases\&quot;, \&quot;Application Layer\&quot;, \&quot;Orquestra o fluxo de negocio\&quot;)\n  Component(domainModel, \&quot;Domain Model\&quot;, \&quot;DDD Entities/Aggregates\&quot;, \&quot;Regras de negocio e transicoes da ordem de servico\&quot;)\n  Component(inMemoryRepos, \&quot;In-Memory Repositories\&quot;, \&quot;Infrastructure\&quot;, \&quot;Persistencia temporaria para MVP e fase inicial de testes\&quot;)\n  Component(singletonWiring, \&quot;Singletons/Providers\&quot;, \&quot;NestJS Providers\&quot;, \&quot;Compoe dependencias entre controllers, use cases e repositorios\&quot;)\n}\n\nRel(cliente, httpControllers, \&quot;Consulta status e aprova orcamento\&quot;, \&quot;HTTP/REST\&quot;)\nRel(atendente, httpControllers, \&quot;Cria e gerencia OS\&quot;, \&quot;HTTP/REST\&quot;)\nRel(mecanico, httpControllers, \&quot;Atualiza execucao\&quot;, \&quot;HTTP/REST\&quot;)\nRel(atendente, authController, \&quot;Realiza login\&quot;, \&quot;POST /auth/login\&quot;)\nRel(mecanico, authController, \&quot;Realiza login\&quot;, \&quot;POST /auth/login\&quot;)\n\nRel(authController, authService, \&quot;Autentica e gera token\&quot;, \&quot;Metodo\&quot;)\nRel(httpControllers, jwtGuard, \&quot;Protege endpoints\&quot;, \&quot;Nest Guard\&quot;)\nRel(jwtGuard, jwtStrategy, \&quot;Valida token\&quot;, \&quot;Passport\&quot;)\nRel(httpControllers, rolesGuard, \&quot;Aplica RBAC\&quot;, \&quot;@Roles\&quot;)\nRel(httpControllers, useCases, \&quot;Invoca\&quot;, \&quot;Metodo\&quot;)\nRel(useCases, domainModel, \&quot;Aplica regras\&quot;, \&quot;Objeto de dominio\&quot;)\nRel(useCases, inMemoryRepos, \&quot;Le/Escreve\&quot;, \&quot;Repository\&quot;)\nRel(singletonWiring, useCases, \&quot;Instancia e injeta\&quot;, \&quot;Nest DI\&quot;)\nRel(singletonWiring, inMemoryRepos, \&quot;Registra implementacoes\&quot;, \&quot;Nest DI\&quot;)\n\nRel(useCases, notificacao, \&quot;Envia notificacoes\&quot;, \&quot;Async (futuro)\&quot;)\nRel(useCases, pagamento, \&quot;Processa pagamentos\&quot;, \&quot;HTTP (futuro)\&quot;)\n\nSHOW_LEGEND()\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="bwQrumHiELmRNkQxHxm8-3">
